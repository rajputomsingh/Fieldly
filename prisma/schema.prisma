generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id                     String                  @id @default(cuid())
  clerkUserId            String                  @unique
  email                  String                  @unique
  name                   String
  imageUrl               String?
  role                   UserRole?
  isOnboarded            Boolean                 @default(false)
  onboardingStep         Int                     @default(0)
  phone                  String?
  state                  String?
  district               String?
  bio                    String?
  isActive               Boolean                 @default(true)
  deletedAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  adminActions           AdminAction[]
  adminConfigUpdates     AdminConfig[]           @relation("AdminConfigUpdatedBy")
  adminSessions          AdminSession[]
  applications           Application[]
  auditLogs              AuditLog[]
  bids                   Bid[]
  assignedDisputes       Dispute[]               @relation("AssignedDisputes")
  filedDisputes          Dispute[]               @relation("DisputeFiledBy")
  disputeResolutions     DisputeResolution[]
  documents              Document[]
  farmerProfile          FarmerProfile?
  listingsOwned          LandListing[]
  landownerProfile       LandownerProfile?
  leasesAsFarmer         Lease[]                 @relation("FarmerLeases")
  leasesAsOwner          Lease[]                 @relation("OwnerLeases")
  leaseSignatures        LeaseSignature[]
  marketSubscriptions    MarketSubscription[]
  messagesReceived       Message[]               @relation("MessagesReceived")
  messagesSent           Message[]               @relation("MessagesSent")
  notifications          Notification[]
  payments               Payment[]
  platformSettings       PlatformSetting[]
  generatedReports       Report[]
  reviewsReceived        Review[]                @relation("Reviewee")
  reviewsGiven           Review[]                @relation("Reviewer")
  savedListings          SavedListing[]
  scheduledNotifications ScheduledNotification[]
  securityEvents         SecurityEvent[]
  subscription           Subscription?

  @@index([clerkUserId])
  @@index([email])
  @@index([role])
  @@index([isActive, deletedAt])
}

// ============================================
// ADMIN & GOVERNANCE
// ============================================

model AdminConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  category    String   @default("GENERAL")
  isEncrypted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?
  admin       User?    @relation("AdminConfigUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([key])
  @@index([category])
}

model AdminSession {
  id            String    @id @default(cuid())
  adminId       String
  tokenHash     String    @unique
  ipAddress     String
  userAgent     String?
  location      String?
  deviceInfo    Json?
  ips           String[]  @default([])
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  lastActive    DateTime  @default(now())
  isRevoked     Boolean   @default(false)
  revokedAt     DateTime?
  revokedBy     String?
  revokedReason String?
  admin         User      @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([isRevoked])
  @@index([adminId, isRevoked])
}

model AdminAction {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entity    String
  entityId  String?
  changes   Json?
  metadata  Json?
  ipAddress String
  userAgent String?
  createdAt DateTime @default(now())
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String
  description String?
  isPublic    Boolean  @default(false)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  admin       User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([key])
  @@index([category])
}

model Report {
  id          String    @id @default(cuid())
  type        String
  title       String
  description String?
  filters     Json?
  data        Json
  format      String    @default("JSON")
  fileUrl     String?
  generatedBy String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  admin       User      @relation(fields: [generatedBy], references: [id], onDelete: Restrict)

  @@index([type])
  @@index([generatedBy])
  @@index([createdAt])
}

// ============================================
// DISPUTE MANAGEMENT
// ============================================

model Dispute {
  id          String              @id @default(cuid())
  type        String
  entityId    String
  filedById   String
  filedByRole UserRole
  reason      String
  description String?
  status      DisputeStatus       @default(PENDING)
  priority    DisputePriority     @default(MEDIUM)
  assignedTo  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  resolvedAt  DateTime?
  resolution  String?
  assigned    User?               @relation("AssignedDisputes", fields: [assignedTo], references: [id], onDelete: SetNull)
  filedBy     User                @relation("DisputeFiledBy", fields: [filedById], references: [id], onDelete: Restrict)
  resolutions DisputeResolution[]

  @@index([filedById])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([status, priority, createdAt])
}

model DisputeResolution {
  id        String   @id @default(cuid())
  disputeId String
  adminId   String
  action    String
  notes     String
  metadata  Json?
  createdAt DateTime @default(now())
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Restrict)

  @@index([disputeId])
  @@index([adminId])
}

// ============================================
// SECURITY & RATE LIMITING
// ============================================

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  endpoint  String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([resetAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  type      String
  severity  String
  userId    String?
  ipAddress String
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([severity])
  @@index([ipAddress])
  @@index([createdAt])
}

// ============================================
// PAYMENT WEBHOOKS
// ============================================

model PaymentWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  paymentId   String?
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([eventType])
  @@index([paymentId])
  @@index([processedAt])
}

// ============================================
// USER PROFILES
// ============================================

model FarmerProfile {
  id                String      @id @default(cuid())
  userId            String      @unique
  primaryCrops      String[]
  farmingExperience Int
  farmingType       FarmingType
  requiredLandSize  Float
  leaseDuration     Int
  irrigationNeeded  Boolean     @default(false)
  equipmentAccess   Boolean     @default(false)
  isVerified        Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model LandownerProfile {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  ownershipType             String?
  verificationLevel         Int      @default(0)
  preferredPaymentFrequency String?
  preferredContactMethod    String?
  isVerified                Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  lands                     Land[]
  user                      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// ============================================
// LAND & LISTINGS
// ============================================

model Land {
  id                               String                 @id @default(cuid())
  landownerId                      String
  title                            String
  size                             Float
  landType                         LandType
  soilType                         String?
  latitude                         Float?
  longitude                        Float?
  village                          String?
  irrigationAvailable              Boolean                @default(false)
  electricityAvailable             Boolean?               @default(false)
  roadAccess                       Boolean?               @default(false)
  fencingAvailable                 Boolean?               @default(false)
  storageAvailable                 Boolean?               @default(false)
  allowedCropTypes                 String[]
  allowsInfrastructureModification Boolean                @default(false)
  allowsOrganicFarming             Boolean                @default(true)
  allowsSubleasing                 Boolean                @default(false)
  depositAmount                    Decimal?               @db.Decimal(12, 2)
  expectedRentMin                  Decimal?               @db.Decimal(10, 2)
  expectedRentMax                  Decimal?               @db.Decimal(10, 2)
  minLeaseDuration                 Int
  maxLeaseDuration                 Int
  availabilityStatus               LandAvailabilityStatus @default(AVAILABLE)
  createdAt                        DateTime               @default(now())
  updatedAt                        DateTime               @updatedAt
  address                          String?
  description                      String?
  district                         String?
  isActive                         Boolean                @default(true)
  pincode                          String?
  preferredPaymentFrequency        PaymentFrequency?
  previousCrops                    String[]
  saves                            Int                    @default(0)
  soilReportAvailable              Boolean                @default(false)
  state                            String?
  views                            Int                    @default(0)
  waterSource                      String?
  editCount                        Int                    @default(0)
  isArchived                       Boolean                @default(false)
  lastEditedAt                     DateTime?
  version                          Int                    @default(0)
  applications                     Application[]
  documents                        Document[]
  landowner                        LandownerProfile       @relation(fields: [landownerId], references: [id], onDelete: Restrict)
  listings                         LandListing[]
  leases                           Lease[]
  images                           ListingImage[]
  soilReports                      SoilReport[]

  @@index([landownerId])
  @@index([landType])
  @@index([isActive])
  @@index([isArchived])
  @@index([availabilityStatus])
  @@index([createdAt])
  @@index([district, state])
}

model LandListing {
  id                   String            @id @default(cuid())
  landId               String
  ownerId              String
  title                String
  description          String?
  listingType          ListingType       @default(OPEN_BIDDING)
  status               ListingStatus     @default(DRAFT)
  basePrice            Decimal           @db.Decimal(12, 2)
  reservePrice         Decimal?          @db.Decimal(12, 2)
  buyNowPrice          Decimal?          @db.Decimal(12, 2)
  minimumLeaseDuration Int
  maximumLeaseDuration Int
  startDate            DateTime
  endDate              DateTime
  totalBids            Int               @default(0)
  highestBid           Decimal?          @db.Decimal(12, 2)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  applicationCount     Int               @default(0)
  publishedAt          DateTime?
  viewCount            Int               @default(0)
  auctionStatus        AuctionStatus     @default(UPCOMING)
  autoExtendMinutes    Int?              @default(5)
  bidIncrement         Decimal?          @default(1000) @db.Decimal(10, 2)
  currentLeaderId      String?
  engagementScore      Float?
  hotnessScore         Float?
  lastBidAt            DateTime?
  marketScore          Float?
  riskLevel            RiskLevel         @default(LOW)
  winningBidId         String?           @unique
  version              Int               @default(0)
  applications         Application[]
  auctionEvents        AuctionEvent[]
  bids                 Bid[]
  land                 Land              @relation(fields: [landId], references: [id], onDelete: Restrict)
  owner                User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  winningBid           Bid?              @relation("WinningBid", fields: [winningBidId], references: [id])
  leases               Lease[]
  analytics            ListingAnalytics?
  images               ListingImage[]
  terms                ListingTerms?
  savedBy              SavedListing[]

  @@index([ownerId])
  @@index([landId, ownerId])
  @@index([status, auctionStatus, endDate])
  @@index([listingType])
  @@index([startDate, endDate])
  @@index([createdAt])
  @@index([auctionStatus, endDate])
  @@index([hotnessScore])
}

model ListingTerms {
  id                      String           @id @default(cuid())
  listingId               String           @unique
  securityDepositRequired Boolean          @default(true)
  depositAmount           Decimal?         @db.Decimal(10, 2)
  paymentFrequency        PaymentFrequency
  additionalTerms         String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  inspectionRequired      Boolean          @default(false)
  insuranceRequired       Boolean          @default(false)
  listing                 LandListing      @relation(fields: [listingId], references: [id], onDelete: Restrict)
}

model ListingImage {
  id        String       @id @default(cuid())
  listingId String?
  url       String
  caption   String?
  isPrimary Boolean      @default(false)
  createdAt DateTime     @default(now())
  sortOrder Int          @default(0)
  landId    String?
  land      Land?        @relation(fields: [landId], references: [id], onDelete: SetNull)
  listing   LandListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([landId])
  @@index([isPrimary])
}

// ============================================
// BIDDING & AUCTIONS
// ============================================

model Bid {
  id        String         @id @default(cuid())
  listingId String
  farmerId  String
  amount    Decimal        @db.Decimal(12, 2)
  status    BidStatus      @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  message   String?
  isAutoBid Boolean        @default(false)
  isWinning Boolean        @default(false)
  outbidAt  DateTime?
  sequence  Int
  version   Int            @default(0)
  events    AuctionEvent[]
  farmer    User           @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  listing   LandListing    @relation(fields: [listingId], references: [id], onDelete: Restrict)
  winningOf LandListing?   @relation("WinningBid")

  @@index([listingId])
  @@index([farmerId])
  @@index([status])
  @@index([listingId, amount(sort: Desc)])
  @@index([listingId, createdAt])
  @@index([listingId, status, amount(sort: Desc)])
  @@index([farmerId, createdAt(sort: Desc)])
  @@index([listingId, sequence])
}

model AuctionEvent {
  id        String      @id @default(cuid())
  listingId String
  type      String
  actorId   String?
  bidId     String?
  metadata  Json?
  createdAt DateTime    @default(now())
  bid       Bid?        @relation(fields: [bidId], references: [id], onDelete: SetNull)
  listing   LandListing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([listingId])
  @@index([createdAt])
}

// ============================================
// APPLICATIONS & LEASES
// ============================================

model Application {
  id           String            @id @default(cuid())
  landId       String
  farmerId     String
  listingId    String?
  proposedRent Decimal?          @db.Decimal(10, 2)
  duration     Int
  cropPlan     String?
  message      String?
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  reviewNotes  String?
  reviewedAt   DateTime?
  version      Int               @default(0)
  farmer       User              @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  land         Land              @relation(fields: [landId], references: [id], onDelete: Restrict)
  listing      LandListing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@unique([landId, farmerId, status])
  @@index([farmerId])
  @@index([landId])
  @@index([listingId])
  @@index([status])
  @@index([createdAt])
  @@index([farmerId, status])
  @@index([landId, status])
  @@index([landId, status, createdAt(sort: Desc)])
  @@index([listingId, status])
}

model Lease {
  id                 String                 @id @default(cuid())
  landId             String
  farmerId           String
  ownerId            String
  listingId          String?
  rent               Decimal                @db.Decimal(10, 2)
  securityDeposit    Decimal?               @db.Decimal(10, 2)
  startDate          DateTime
  endDate            DateTime
  // lifecycleStatus is the CANONICAL state machine.
  // status is a backwards-compatible simplified representation.
  // NEVER mutate both independently. Use leaseStateMachine.transition()
  lifecycleStatus    LeaseLifecycleStatus   @default(DRAFT)
  status             LeaseStatus            @default(DRAFT)
  paymentStatus      LeasePaymentStatus     @default(PENDING)
  farmerSignedAt     DateTime?
  ownerSignedAt      DateTime?
  signedAt           DateTime?
  activatedAt        DateTime?
  terminatedAt       DateTime?
  terminatedBy       String?
  terminationReason  TerminationReason?
  creditApproved     Boolean                @default(false)
  escrowStatus       EscrowStatus?
  escrowReleasedAt   DateTime?
  grossContractValue Decimal?               @db.Decimal(12, 2)
  leaseSource        LeaseSource            @default(AUCTION)
  netOwnerReceivable Decimal?               @db.Decimal(10, 2)
  platformFee        Decimal?               @db.Decimal(8, 2)
  riskScore          Float?
  version            Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  agreements         LeaseAgreement[]
  events             LeaseEvent[]
  paymentSchedule    LeasePaymentSchedule[]
  farmer             User                   @relation("FarmerLeases", fields: [farmerId], references: [id], onDelete: Restrict)
  land               Land                   @relation(fields: [landId], references: [id], onDelete: Restrict)
  listing            LandListing?           @relation(fields: [listingId], references: [id], onDelete: SetNull)
  owner              User                   @relation("OwnerLeases", fields: [ownerId], references: [id], onDelete: Restrict)
  payments           Payment[]
  review             Review?

  @@index([farmerId])
  @@index([ownerId])
  @@index([landId])
  @@index([status])
  @@index([lifecycleStatus])
  @@index([startDate, endDate])
  @@index([riskScore])
  @@index([farmerId, lifecycleStatus])
  @@index([ownerId, lifecycleStatus])
  @@index([landId, lifecycleStatus])
  @@index([startDate, endDate, lifecycleStatus])
  @@index([paymentStatus, lifecycleStatus])
}

// ============================================
// LEASE AGREEMENTS & SIGNATURES
// ============================================

model LeaseAgreement {
  id              String           @id @default(cuid())
  leaseId         String
  version         Int
  status          AgreementStatus  @default(DRAFT)
  templateVersion String?
  documentUrl     String?
  documentHash    String?
  metadata        Json?
  generatedAt     DateTime         @default(now())
  finalizedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lease           Lease            @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  signatures      LeaseSignature[]

  @@unique([leaseId, version])
  @@index([leaseId])
  @@index([status])
}

model LeaseSignature {
  id            String         @id @default(cuid())
  agreementId   String
  signerId      String
  signerRole    UserRole
  signedAt      DateTime
  signatureHash String?
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime       @default(now())
  agreement     LeaseAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  signer        User           @relation(fields: [signerId], references: [id], onDelete: Restrict)

  @@unique([agreementId, signerId])
  @@index([agreementId])
  @@index([signerId])
}

// ============================================
// LEASE PAYMENT SCHEDULE (NEW)
// ============================================

model LeasePaymentSchedule {
  id              String        @id @default(cuid())
  leaseId         String
  installmentNo   Int
  paymentType     PaymentType
  amount          Decimal       @db.Decimal(10, 2)
  dueDate         DateTime
  gracePeriodEnds DateTime?
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lease           Lease         @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  payments        Payment[]

  @@unique([leaseId, installmentNo])
  @@index([leaseId, status])
  @@index([dueDate, status])
}

// ============================================
// LEASE EVENTS (NEW)
// ============================================

model LeaseEvent {
  id        String   @id @default(cuid())
  leaseId   String
  actorId   String?
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  lease     Lease    @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@index([leaseId, createdAt])
  @@index([type, createdAt])
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id                String                @id @default(cuid())
  idempotencyKey    String?               @unique
  userId            String
  leaseId           String?
  scheduleId        String?
  amount            Decimal               @db.Decimal(10, 2)
  currency          String                @default("INR")
  status            PaymentStatus         @default(PENDING)
  provider          PaymentProvider       @default(RAZORPAY)
  providerRef       String?               @unique
  razorpayOrderId   String?               @unique
  razorpayPaymentId String?               @unique
  razorpaySignature String?
  paymentType       PaymentType
  gatewayFee        Decimal?              @db.Decimal(8, 2)
  netAmount         Decimal?              @db.Decimal(10, 2)
  platformFee       Decimal?              @db.Decimal(8, 2)
  attempts          Int                   @default(1)
  lastAttemptAt     DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  dueDate           DateTime?
  paidAt            DateTime?
  refundedAt        DateTime?
  notes             String?
  receiptUrl        String?
  metadata          Json?
  version           Int                   @default(0)
  lease             Lease?                @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  schedule          LeasePaymentSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([leaseId])
  @@index([scheduleId])
  @@index([status])
  @@index([paymentType])
  @@index([provider])
  @@index([dueDate])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([idempotencyKey])
  @@index([providerRef])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([razorpayOrderId, status])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([leaseId, status])
  @@index([dueDate, status])
  @@index([paymentType, status])
}

// ============================================
// REVIEWS & MESSAGING
// ============================================

model Review {
  id         String   @id @default(cuid())
  leaseId    String   @unique
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  response   String?
  lease      Lease    @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Restrict)
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([revieweeId])
  @@index([rating])
}

model Message {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime  @default(now())
  isRead     Boolean   @default(false)
  readAt     DateTime?
  receiver   User      @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Restrict)
  sender     User      @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@index([createdAt])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  actionUrl  String?
  readAt     DateTime?
  entityId   String?
  entityType String?
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId, isRead, createdAt])
}

model ScheduledNotification {
  id          String    @id @default(cuid())
  title       String
  message     String
  priority    String    @default("MEDIUM")
  targetType  String
  targetRole  String?
  targetIds   String[]  @default([])
  actionUrl   String?
  scheduledAt DateTime
  sentAt      DateTime?
  status      String    @default("PENDING")
  adminId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  admin       User      @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([status, scheduledAt])
  @@index([adminId])
}

// ============================================
// MARKETPLACE FEATURES
// ============================================

model SavedListing {
  id        String      @id @default(cuid())
  listingId String
  userId    String
  createdAt DateTime    @default(now())
  listing   LandListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([listingId, userId])
  @@index([userId])
  @@index([createdAt])
}

model ListingAnalytics {
  listingId       String      @id
  demandScore     Float?
  bidVelocity     Float?
  conversionScore Float?
  avgBidGap       Float?
  watchers        Int         @default(0)
  lastActivityAt  DateTime?
  listing         LandListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
}

model MarketSubscription {
  id        String   @id @default(cuid())
  userId    String
  filters   Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String             @unique
  plan        String
  status      SubscriptionStatus @default(ACTIVE)
  startedAt   DateTime           @default(now())
  endsAt      DateTime?
  autoRenew   Boolean            @default(true)
  lastBilling DateTime?
  nextBilling DateTime?
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// ============================================
// DOCUMENTS & SOIL REPORTS
// ============================================

model SoilReport {
  id        String    @id @default(cuid())
  landId    String
  ph        Float?
  moisture  Float?
  nutrients String?
  createdAt DateTime  @default(now())
  reportUrl String?
  testedAt  DateTime?
  testedBy  String?
  land      Land      @relation(fields: [landId], references: [id], onDelete: Restrict)

  @@index([landId])
  @@index([testedAt])
}

model Document {
  id        String   @id @default(cuid())
  userId    String?
  landId    String?
  name      String
  url       String
  createdAt DateTime @default(now())
  size      Int?
  type      String?
  land      Land?    @relation(fields: [landId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([landId])
  @@index([type])
}

// ============================================
// AUDIT & LOGGING
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  entity    String?
  entityId  String?
  ipAddress String?
  userAgent String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

